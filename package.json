{
  "name": "graceful-kill",
  "version": "9.1.0",
  "description": "gracefully kills a spawn process",
  "keywords": [],
  "homepage": "https://github.com/christophehurpeau/graceful-kill",
  "bugs": {
    "url": "https://github.com/christophehurpeau/graceful-kill/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": "https://github.com/christophehurpeau/graceful-kill.git",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index-node.mjs",
  "types": "./dist/definitions/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/definitions/index.d.ts",
      "node": {
        "import": "./dist/index-node.mjs"
      }
    }
  },
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsrs -p tsconfig.json",
    "clean": "yarn clean:build",
    "clean:build": "pob-esbuild-clean-out dist",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run format && pnpm run lint:oxlint && tsrs && pnpm run lint:eslint",
    "lint:eslint": "eslint --quiet .",
    "lint:oxlint": "oxlint --quiet",
    "prepare": "pob-root-postinstall",
    "test": "TZ=UTC vitest",
    "test:coverage": "TZ=UTC POB_VITEST_COVERAGE=json,text vitest run --coverage",
    "test:coverage:generate": "TZ=UTC POB_VITEST_COVERAGE=json vitest run --coverage",
    "test:watch": "TZ=UTC vitest --watch",
    "tsc": "tsrs && tsrs -p tsconfig.tools.json",
    "tsc:go": "tsc && tsc -p tsconfig.tools.json",
    "watch": "yarn clean:build && rollup --config rollup.config.mjs --watch"
  },
  "dependencies": {
    "nightingale-logger": "^18.2.0"
  },
  "devDependencies": {
    "@pob/eslint-config": "68.0.0",
    "@pob/rollup-esbuild": "11.1.0",
    "@pob/root": "28.2.0",
    "@types/node": "22.18.13",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pob": {
    "bundler": "rollup-esbuild",
    "entries": [
      "index"
    ],
    "envs": [
      {
        "target": "node",
        "version": "22",
        "omitVersionInFileName": true
      }
    ],
    "typescript": true
  }
}
